# Imported with --walk-row 1 --map sleep=5:3,4: this sheet's row 1
# faces right, and row 5 has closed-eye poses instead of a synthetic blink.

name = "Rubber Duck"
render_mode = "smooth"
scale = 1

[source]
art = "Rubber Duck Debugger, cut from the petscodex (petdex) pet `rubber-duck-debugger` by scripts/import-pet.py. A companion inspired by rubber duck debugging: patient listening that helps developers explain code, expose assumptions, and discover solutions."
url = "https://petscodex.com/pets/rubber-duck-debugger"
license = "MIT for these frames as cut and arranged here, along with the personality prose and the manifest. The art those frames adapt is not: it declares no license anywhere in the source ecosystem, and the importer warned so."

# A patient listener leaves longer silences when nobody addresses it.

[director]
model_base = 2
model_power = 1

[cursor]
near_reaction = "face"
rush_reaction = "react"

[animations.idle]
frames = ["frames/idle-0.png", "frames/idle-1.png", "frames/idle-2.png", "frames/idle-3.png", "frames/idle-4.png", "frames/idle-5.png"]
fps = 5
weight = 30

[animations.waiting]
frames = ["frames/waiting-0.png", "frames/waiting-1.png", "frames/waiting-2.png", "frames/waiting-3.png", "frames/waiting-4.png", "frames/waiting-5.png"]
fps = 6
variant_of = "idle"

[animations.walk]
frames = ["frames/walk-0.png", "frames/walk-1.png", "frames/walk-2.png", "frames/walk-3.png", "frames/walk-4.png", "frames/walk-5.png", "frames/walk-6.png", "frames/walk-7.png"]
fps = 8

[animations.talk]
frames = ["frames/talk-0.png", "frames/talk-1.png", "frames/talk-2.png", "frames/talk-3.png"]
fps = 6

[animations.fall]
frames = ["frames/fall-0.png", "frames/fall-1.png"]
fps = 6

[animations.land]
frames = ["frames/land-0.png", "frames/land-1.png", "frames/idle-0.png"]
fps = 6
loop = "once"

[animations.hold]
frames = ["frames/hold-0.png", "frames/hold-1.png"]
fps = 6

[animations.react]
frames = ["frames/react-0.png", "frames/react-1.png", "frames/react-2.png", "frames/react-3.png", "frames/react-4.png", "frames/react-5.png", "frames/react-6.png", "frames/react-7.png"]
fps = 7
loop = "once"

[animations.sit]
frames = ["frames/sit-0.png", "frames/sit-1.png", "frames/sit-2.png", "frames/sit-3.png", "frames/sit-4.png", "frames/sit-5.png"]
fps = 6

[animations.sleep]
frames = ["frames/sleep-0.png", "frames/sleep-1.png"]
fps = 1

# Listening outweighs interruptions; a walk waits for a pause in typing.
[behaviors.listen]
play = ["idle"]
weight = 50

[behaviors.ask]
play = ["talk", "idle"]
weight = 10
when = "idle under 1m"

[behaviors.greet]
play = ["talk"]
then = "listen"
weight = 20
when = "idle under 10s"

[behaviors.waddle]
play = ["walk", "idle"]
weight = 20
when = "idle over 30s"

[behaviors.ponder]
play = ["sit"]
then = "listen"
weight = 30
when = "idle over 1m"

[behaviors.nap]
play = ["sit", "sleep"]
weight = 40
when = "idle over 5m"
